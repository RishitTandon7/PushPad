// PushPad cleanup job: every 5 minutes destroys branch previews that are orphaned or too old,
// and short-term deployments whose 10 minutes are up.
pipeline {
  agent any

  triggers {
    // Run roughly every 5 minutes.
    cron('H/5 * * * *')
  }

  options {
    disableConcurrentBuilds()
    timeout(time: 30, unit: 'MINUTES')
  }

  environment {
    AWS_DEFAULT_REGION = "${env.AWS_DEFAULT_REGION ?: 'us-east-1'}"
    TF_IN_AUTOMATION   = '1'
  }

  stages {
    // 1. Checkout: need the repo for scripts and for its remote URL (git ls-remote).
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    // 2. Destroy orphaned previews: remove environments for deleted branches and previews older than 24h.
    stage('Destroy orphaned previews') {
      steps {
        sh './scripts/cleanup.sh'
      }
    }

    // 3. Destroy expired deployments: servers whose ExpiresAt tag has passed, plus leftovers from failed runs.
    stage('Destroy expired deployments') {
      steps {
        sh './scripts/deploy/cleanup-deployments.sh'
      }
    }
  }
}
