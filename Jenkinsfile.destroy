// PushPad destroy job: removes one deployment early (user clicked Delete). Triggered by the control plane.
pipeline {
  agent any

  parameters {
    string(name: 'DEPLOY_ID', defaultValue: '', description: 'Deployment id (10 hex characters)')
  }

  options {
    timeout(time: 15, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '30'))
  }

  environment {
    AWS_DEFAULT_REGION = "${env.AWS_DEFAULT_REGION ?: 'us-east-1'}"
    TF_IN_AUTOMATION   = '1'
  }

  stages {
    // 1. Checkout: get the scripts.
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    // 2. Destroy: terraform destroy, delete the workspace, delete the S3 objects.
    stage('Destroy') {
      steps {
        sh 'scripts/deploy/destroy.sh'
      }
    }

    // 3. Report: tell the control plane the deployment is gone.
    stage('Report') {
      steps {
        sh 'scripts/deploy/report.sh - destroyed'
      }
    }
  }

  post {
    failure {
      sh 'scripts/deploy/report.sh - failed "Could not delete the deployment." || true'
    }
  }
}
